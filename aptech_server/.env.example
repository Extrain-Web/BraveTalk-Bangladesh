# Copy to .env and fill in. Never commit the real .env.
PORT=5000
NODE_ENV=development
DATABASE_URL=mongodb://USER:PASSWORD@HOST:27017/bravetalk?authSource=admin&directConnection=true

JWT_ACCESS_SECRET=change-me-long-random-string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

CLIENT_URL=http://localhost:3000
# Extra allowed site origins (comma-separated), e.g. https://www.example.com
CORS_ORIGINS=
FRONTEND_URL=http://localhost:3000

# Optional services
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=BraveTalk Bangladesh
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
GEMINI_API_KEY=
